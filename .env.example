# Copy this file to .env and fill it in. Never share your .env file.

# Which data to use: auto (tries MT5, then Twelve Data, then demo), mt5, twelvedata, demo
DATA_SOURCE=auto

# Exness MT5 (Windows). Leave the login blank to use the account already open in the terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
# Set only if auto-detection picks the wrong gold symbol, e.g. XAUUSDm
MT5_SYMBOL=
# Hours between the broker's server clock and UTC
MT5_SERVER_UTC_OFFSET=0

# Twelve Data free key (twelvedata.com), used when MT5 is not available
TWELVEDATA_API_KEY=

# Strategy settings
SPREAD_USD=0.30
MIN_RR=2.0
KILLZONE_ONLY=1
HISTORY_BARS=3000
